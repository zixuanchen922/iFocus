{
  "name": "focus-orb-video",
  "version": "1.0.0",
  "description": "Landscape demo of the white-ring focus orb interacting with a countdown timer",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.504",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.504",
    "@remotion/tailwind-v4": "4.0.504",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.504",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:focus": "remotion render FocusInteraction output/focus-interaction.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:alert": "remotion render DistractionAlert output/distraction-alert.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:demo": "remotion render FocusOrbDemo output/focus-orb-demo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
